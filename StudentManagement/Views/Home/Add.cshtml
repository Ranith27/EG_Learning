@{
    ViewData["Title"] = "Add Student";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Add New Student</h1>
    <a href="/Home/Index" class="btn btn-primary">Back to list</a>
</div>

<div style="font-family: Arial, sans-serif; max-width: 400px; line-height: 1.8;">
    <div style="margin-bottom: 10px; display: flex; align-items: center;">
        <label style="width: 80px;">Name:</label>
        <input data-bind="value: name" style="flex: 1; padding: 4px;" />
    </div>

    <div style="margin-bottom: 10px; display: flex; align-items: center;">
        <label style="width: 80px;">Age:</label>
        <input data-bind="value: age" type="number" style="flex: 1; padding: 4px;" />
    </div>

    <div style="margin-bottom: 15px; display: flex; align-items: center;">
        <label style="width: 80px;">Phone:</label>
        <input data-bind="value: phone" style="flex: 1; padding: 4px;" />
    </div>

    <button type="button" data-bind="click: addStudent" style="padding: 6px 12px;background-color: #28a745; color: white; cursor: pointer;">Add</button>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.js"></script>
<script src="~/js/Adding.js"></script>