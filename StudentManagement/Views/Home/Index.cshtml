@{
    ViewData["Title"] = "Home Page";
}

<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h1>Student List</h1>
        <a href="/Home/Add" class="btn btn-primary">Add New Student</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Phone</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: Students">
            <tr>
                <td data-bind="text: id"></td>
                <td data-bind="text: name"></td>
                <td data-bind="text: age"></td>
                <td data-bind="text: phonenumber"></td>
                <td>
                    <a data-bind="attr: { href: '/Home/Edit?id=' + id }" class="btn btn-sm btn-warning">Edit</a>
                    <button data-bind="click: $parent.deleteStudent" class="btn btn-sm btn-danger ms-1">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.js"></script>
<script src="~/js/Landing.js"></script>
